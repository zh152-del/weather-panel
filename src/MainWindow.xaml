<Window x:Class="WeatherPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WeatherPanel" Width="322" Height="423"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="False"
        FontFamily="Microsoft YaHei UI"
        Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Metal.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 通用文本：默认无外边距，靠容器定行高 -->
            <Style x:Key="T" TargetType="TextBlock">
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="TextWrapping" Value="NoWrap"/>
            </Style>
            <Style x:Key="Title" TargetType="TextBlock" BasedOn="{StaticResource T}">
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
                <Setter Property="Height" Value="16"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="Sep" TargetType="Rectangle">
                <Setter Property="Height" Value="1"/>
                <Setter Property="Fill" Value="{StaticResource SepBrush}"/>
                <Setter Property="Margin" Value="0,1,0,1"/>
            </Style>
            <!-- 六天列表的一行 -->
            <DataTemplate x:Key="DayRow">
                <Grid Height="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="76"/>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="34"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12"
                               Foreground="{Binding NameBrush}" VerticalAlignment="Center"/>
                    <Image Grid.Column="1" Source="{Binding IconSource}" Width="20" Height="20"
                           Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding Desc}" FontSize="12"
                               Foreground="{StaticResource SubBrush}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="2,0,4,0"/>
                    <TextBlock Grid.Column="3" Text="{Binding TMin}" FontSize="12"
                               Foreground="{StaticResource DimBrush}" VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>
                    <Grid Grid.Column="4" Margin="4,0,4,0" VerticalAlignment="Center">
                        <Rectangle Height="1" Fill="{StaticResource TrackBrush}" VerticalAlignment="Center"/>
                        <Rectangle Height="3" RadiusX="1.5" RadiusY="1.5"
                                   Fill="{Binding BarBrush}" VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   Margin="{Binding BarMargin}" Width="{Binding BarWidth}"/>
                        <Ellipse Width="5" Height="5" Fill="{Binding DotBrush}" VerticalAlignment="Center"
                                 HorizontalAlignment="Left" Margin="{Binding DotMargin}"/>
                    </Grid>
                    <TextBlock Grid.Column="5" Text="{Binding TMax}" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource FgBrush}" VerticalAlignment="Center"
                               Margin="4,0,0,0"/>
                    <TextBlock Grid.Column="6" Text="{Binding Pop}" FontSize="10"
                               Foreground="{StaticResource DimBrush}" VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>
                </Grid>
            </DataTemplate>
            <!-- 未来 8 小时的一列 -->
            <DataTemplate x:Key="HourCol">
                <StackPanel Width="37" VerticalAlignment="Top">
                    <TextBlock Text="{Binding Time}" FontSize="10.5" Foreground="{Binding TimeBrush}"
                               HorizontalAlignment="Center" Height="16"/>
                    <Image Source="{Binding IconSource}" Width="30" Height="30" Stretch="Uniform"
                           HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Temp}" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource FgBrush}" HorizontalAlignment="Center" Height="17"/>
                    <TextBlock Text="{Binding Pop}" FontSize="9.5" Foreground="{StaticResource DimBrush}"
                               HorizontalAlignment="Center" Height="15"/>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="TiltRoot">
        <!-- ================= 材质层 ================= -->
        <Grid x:Name="Material">
            <Border x:Name="MetalBase" CornerRadius="15" Background="{StaticResource MetalBaseBrush}"/>
            <Grid x:Name="ClipRoot" ClipToBounds="True">
                <Rectangle Fill="{StaticResource VignetteBrush}"/>
                <Ellipse Width="180" Height="130" HorizontalAlignment="Left" VerticalAlignment="Top"
                         Margin="-24,-30,0,0" Fill="{StaticResource WarmBrush}"/>
                <Ellipse Width="220" Height="160" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                         Margin="0,0,-26,-34" Fill="{StaticResource CoolBrush}"/>
                <Border Width="190" Height="4" HorizontalAlignment="Center" VerticalAlignment="Top"
                        Margin="0,-6,0,0" Background="{StaticResource StripBrush}">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <RotateTransform Angle="-18"/>
                        </TransformGroup>
                    </Border.RenderTransform>
                </Border>
            </Grid>
            <Rectangle x:Name="NoiseLayer" Opacity="0.03" IsHitTestVisible="False" Fill="#FFFFFF"/>
            <!-- 倒角：与材质同心的两层，少画一层的原因是多半径会在圆角处错位 -->
            <Border CornerRadius="15" BorderThickness="1" IsHitTestVisible="False"
                    BorderBrush="{StaticResource EdgeOuterBrush}"/>
            <Border CornerRadius="14" BorderThickness="1" Margin="1" IsHitTestVisible="False"
                    BorderBrush="{StaticResource EdgeInnerBrush}"/>
        </Grid>

        <!-- ================= 内容层 ================= -->
        <Grid Margin="13,2,13,3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- A. 城市 / 时钟 / 日期 / 更新时间 -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="20"/>
                </Grid.RowDefinitions>
                <!-- 城市名按要求去掉；日期放大，更新时间并入同一行，时钟靠右 -->
                <TextBlock x:Name="DateText" Grid.Row="0" Grid.Column="0" Text="" Style="{StaticResource T}"
                           FontSize="14" FontWeight="Bold" Foreground="{StaticResource SubBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="UpdateText" Grid.Row="0" Grid.Column="1" Text=""
                           Style="{StaticResource T}" FontSize="11" Margin="8,3,0,0"
                           Foreground="{StaticResource DimBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="ClockText" Grid.Row="0" Grid.Column="2" Text="--:--:--"
                           Style="{StaticResource T}" FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource FgBrush}" VerticalAlignment="Center"/>
            </Grid>

            <!-- B. 当前天气：左视觉块 + 右侧六项指标 -->
            <Grid Grid.Row="1" Margin="0,5,0,0">
                <Rectangle Style="{StaticResource Sep}" VerticalAlignment="Top"/>
                <Grid Margin="0,9,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Width="150">
                        <StackPanel Orientation="Horizontal" Height="68">
                            <Image x:Name="CurIcon" Width="68" Height="68" Stretch="Uniform"
                                   VerticalAlignment="Center" Margin="0,0,0,0"/>
                            <TextBlock x:Name="CurTemp" Text="--°" FontSize="48" FontWeight="Bold"
                                       Foreground="{StaticResource FgBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Height="18">
                            <TextBlock x:Name="CurDesc" Text="获取中…" FontSize="13"
                                       Foreground="{StaticResource SubBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CurHiLo" Text="最高 --° / 最低 --°" FontSize="11"
                                       Foreground="{StaticResource DimBrush}" VerticalAlignment="Center"
                                       Margin="7,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Column="1" VerticalAlignment="Center" Height="51">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="26"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="17"/>
                            <RowDefinition Height="17"/>
                            <RowDefinition Height="17"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="体感" FontSize="11"
                                   Foreground="{StaticResource DimBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="MFeels" Grid.Row="0" Grid.Column="1" Text="--°" FontSize="11.5"
                                   FontWeight="Bold" Foreground="{StaticResource ValBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="湿度" FontSize="11"
                                   Foreground="{StaticResource DimBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="MHum" Grid.Row="0" Grid.Column="3" Text="--%" FontSize="11.5"
                                   FontWeight="Bold" Foreground="{StaticResource ValBrush}" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="风" FontSize="11"
                                   Foreground="{StaticResource DimBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="MWind" Grid.Row="1" Grid.Column="1" Text="--" FontSize="11.5"
                                   FontWeight="Bold" Foreground="{StaticResource ValBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="降水" FontSize="11"
                                   Foreground="{StaticResource DimBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="MPrecip" Grid.Row="1" Grid.Column="3" Text="--" FontSize="11.5"
                                   FontWeight="Bold" Foreground="{StaticResource ValBrush}" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="云量" FontSize="11"
                                   Foreground="{StaticResource DimBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="MCloud" Grid.Row="2" Grid.Column="1" Text="--%" FontSize="11.5"
                                   FontWeight="Bold" Foreground="{StaticResource ValBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="气压" FontSize="11"
                                   Foreground="{StaticResource DimBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="MPress" Grid.Row="2" Grid.Column="3" Text="--" FontSize="11.5"
                                   FontWeight="Bold" Foreground="{StaticResource ValBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Grid>

            <!-- C. 未来 8 小时 -->
            <StackPanel Grid.Row="2" Margin="0,4,0,0">
                <Rectangle Style="{StaticResource Sep}"/>
                <TextBlock Text="未来 8 小时" Style="{StaticResource Title}"/>
                <ItemsControl x:Name="HoursList" Margin="0,1,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <StaticResource ResourceKey="HourCol"/>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- D. 未来 6 天 -->
            <StackPanel Grid.Row="3" Margin="0,4,0,0">
                <Rectangle Style="{StaticResource Sep}"/>
                <Grid Height="16">
                    <TextBlock Text="未来 6 天" Style="{StaticResource Title}"/>
                    <TextBlock Text="降水" FontSize="10" Foreground="{StaticResource DimBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                </Grid>
                <ItemsControl x:Name="DaysList" Margin="0,1,0,0" ItemTemplate="{StaticResource DayRow}"/>
            </StackPanel>

            <!-- E. 天气详情 -->
            <StackPanel Grid.Row="4" Margin="0,4,0,0">
                <Rectangle Style="{StaticResource Sep}"/>
                <TextBlock Text="天气详情" Style="{StaticResource Title}"/>
                <Grid Height="17">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="能见度" FontSize="10" Foreground="{StaticResource DimBrush}"/>
                        <TextBlock x:Name="DVis" Text="--" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource ValBrush}" Margin="4,0,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="露点" FontSize="10" Foreground="{StaticResource DimBrush}"/>
                        <TextBlock x:Name="DDew" Text="--" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource ValBrush}" Margin="4,0,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="阵风" FontSize="10" Foreground="{StaticResource DimBrush}"/>
                        <TextBlock x:Name="DGust" Text="--" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource ValBrush}" Margin="4,0,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="UV" FontSize="10" Foreground="{StaticResource DimBrush}"/>
                        <TextBlock x:Name="DUv" Text="--" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource ValBrush}" Margin="4,0,0,0"/>
                    </StackPanel>
                </Grid>
                <Grid Height="17">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="月相" FontSize="10" Foreground="{StaticResource DimBrush}"/>
                        <TextBlock x:Name="DMoon" Text="--" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource ValBrush}" Margin="4,0,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="日出" FontSize="10" Foreground="{StaticResource DimBrush}"/>
                        <TextBlock x:Name="DRise" Text="--" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource ValBrush}" Margin="4,0,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="日落" FontSize="10" Foreground="{StaticResource DimBrush}"/>
                        <TextBlock x:Name="DSet" Text="--" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource ValBrush}" Margin="4,0,0,0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- ===== 断网提示：整块盖住面板，联网并抓到数据后自动隐藏 ===== -->
        <Border x:Name="NetErrorLayer" CornerRadius="15" Background="#F50A0D11"
                Visibility="Collapsed">
            <Border CornerRadius="12" Background="#F0222730" Width="238"
                    BorderBrush="#55FFB347" BorderThickness="1" Padding="18,15"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.55" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="&#x26A0;" FontFamily="Segoe UI Symbol" FontSize="24"
                               Foreground="#FFB347" HorizontalAlignment="Center"/>
                    <TextBlock Text="网络超时" FontSize="15" FontWeight="Bold"
                               Foreground="#EAEEF4" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="请检查网络，联网后会自动恢复" FontSize="11"
                               Foreground="#A6B2C2" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <TextBlock x:Name="NetErrorHint" Text="" FontSize="10"
                               Foreground="#8A96A6" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
