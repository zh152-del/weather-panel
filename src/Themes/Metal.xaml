<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== 文字配色（沿用 ProcessPanel 深色金属主题） ===== -->
    <SolidColorBrush x:Key="FgBrush" Color="#E8ECF2"/>
    <SolidColorBrush x:Key="ValBrush" Color="#DDE4ED"/>
    <SolidColorBrush x:Key="SubBrush" Color="#A6B2C2"/>
    <SolidColorBrush x:Key="DimBrush" Color="#8A96A6"/>
    <SolidColorBrush x:Key="AccBrush" Color="#7FD4FF"/>
    <SolidColorBrush x:Key="SepBrush" Color="#343C48"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#4E596A"/>
    <SolidColorBrush x:Key="BarBrush" Color="#A8BDD2"/>
    <SolidColorBrush x:Key="BarTodayBrush" Color="#7FD4FF"/>

    <!-- ===== 材质层 ===== -->
    <!-- 金属底：深枪灰对角渐变，91% 不透明，保留轻微背景透感 -->
    <LinearGradientBrush x:Key="MetalBaseBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#DC212530" Offset="0"/>
        <GradientStop Color="#DC171A1F" Offset="1"/>
    </LinearGradientBrush>

    <!-- 中央暗区：制造凹面纵深 -->
    <RadialGradientBrush x:Key="VignetteBrush" GradientOrigin="0.5,0.40" Center="0.5,0.40"
                         RadiusX="0.78" RadiusY="0.82">
        <GradientStop Color="#6C0B0D10" Offset="0"/>
        <GradientStop Color="#000B0D10" Offset="1"/>
    </RadialGradientBrush>

    <!-- 反射光源：暖琥珀球（左上）/ 冷蓝光斑（右下）/ 顶部灯条 -->
    <RadialGradientBrush x:Key="WarmBrush" GradientOrigin="0.5,0.5" Center="0.5,0.5"
                         RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#34F2C08A" Offset="0"/>
        <GradientStop Color="#1AF2C08A" Offset="0.45"/>
        <GradientStop Color="#00F2C08A" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="CoolBrush" GradientOrigin="0.5,0.5" Center="0.5,0.5"
                         RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#267FA6C9" Offset="0"/>
        <GradientStop Color="#127FA6C9" Offset="0.5"/>
        <GradientStop Color="#007FA6C9" Offset="1"/>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="StripBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00FFFFFF" Offset="0"/>
        <GradientStop Color="#22FFFFFF" Offset="0.5"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- 倒角：外缘上亮中暗下亮，内缘反向，形成金属内斜面 -->
    <LinearGradientBrush x:Key="EdgeOuterBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#74FFFFFF" Offset="0"/>
        <GradientStop Color="#22FFFFFF" Offset="0.5"/>
        <GradientStop Color="#4AFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EdgeInnerBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#30FFFFFF" Offset="0"/>
        <GradientStop Color="#14000000" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
